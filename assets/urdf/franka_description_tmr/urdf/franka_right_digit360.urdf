  <gazebo reference="lidar_rear">
    <material value="Gazebo/Yellow"/>
    <sensor name="lidar_rear" type="gpu_lidar">
      <topic>/lidar_rear/scan</topic>
      <update_rate>50.0</update_rate>
      <gz_frame_id>lidar_rear</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>500</samples>
            <resolution>1</resolution>
            <min_angle>-0.7853981633974483</min_angle>
            <max_angle>3.9269908169872414</max_angle>
          </horizontal>
          <vertical>
            <samples>16</samples>
            <resolution>1</resolution>
            <min_angle>-0.261799</min_angle>
            <max_angle>0.261799</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.05</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.006</stddev>
        </noise>
      </lidar>
      <visualize>true</visualize>
    </sensor>
